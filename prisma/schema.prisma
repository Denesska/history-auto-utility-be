// prisma/schema.prisma

// Connection URL is no longer set here in Prisma 7 — see prisma.config.ts (CLI/Migrate)
// and PrismaService (app runtime, via the @prisma/adapter-pg driver adapter).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   Int                     @id @default(autoincrement())
  google_id            String                  @unique
  email                String                  @unique
  first_name           String
  last_name            String
  picture              String
  created_at           DateTime                @default(now())
  // Grants access to the /admin stats page. Set by hand in the DB, never via the API.
  is_admin             Boolean                 @default(false)
  // Throttled — written by ActivityService's periodic flush, not on every request.
  last_active_at       DateTime?
  activity_days        UserActivityDay[]
  cars                 Car[]
  refresh_token        String?
  /// Set only for `is_company_managed` accounts — Google-identity accounts never have a password, they always log in via OAuth.
  password_hash        String?
  /// True right after creation or after a company-triggered reset — the account can only use the default password until it sets its own (see AuthService.changePassword).
  /// Short globally-unique login name (lowercase [a-z0-9], 3-20) of an `is_company_managed` account, e.g. `gandzde` — see OrganizationService.createLocalMember. Null for Google-identity accounts.
  username             String?                 @unique
  must_change_password Boolean                 @default(false)
  /// True for an account created directly by a company (Director/Owner/Fleet Admin) rather than through Google sign-in — see OrganizationService.createLocalMember. Logs in with username+password (`/auth/local-login`), fully owned by the company that created it: they can reset its password or remove it outright (which also disables the account, see `disabled_at`).
  is_company_managed   Boolean                 @default(false)
  /// Set when the owning company removes one of its `is_company_managed` accounts — blocks login immediately (checked in JwtStrategy/AuthService). Never set on a Google-identity account.
  disabled_at          DateTime?
  car_accesses         CarUserAccess[]         @relation("UserAccesses")
  invitations          CarUserAccess[]         @relation("InvitedBy")
  blog_entries         BlogEntry[]
  uploaded_files       UploadedFile[]
  settings             UserSettings?
  deadline_orders      CarDeadlineOrder[]
  notifications        Notification[]
  push_tokens          PushToken[]
  reminders_sent       DocumentReminderSent[]
  maintenance_settings CarMaintenanceSetting[]
  maintenance_profiles MaintenanceProfile[]
  sale_contracts       SaleContract[]
  identity             UserIdentity?
  organization_memberships       OrganizationMembership[] @relation("OrganizationMemberships")
  organization_invitations_sent  OrganizationMembership[] @relation("OrganizationInvitedBy")
  feature_interests               FeatureInterest[]
  suppliers                       Supplier[]
  driver_assignments               CarDriverAssignment[] @relation("DriverAssignments")
  driver_assignments_made          CarDriverAssignment[] @relation("DriverAssignmentsMadeBy")
  car_nicknames                    CarUserNickname[]
  business_access_requests         BusinessAccessRequest[] @relation("BusinessAccessRequests")
  business_access_decisions        BusinessAccessRequest[] @relation("BusinessAccessDecisions")
}

model Car {
  id                        Int                     @id @default(autoincrement())
  vin                       String?                 @unique
  /// DEPRECATED (2026-10-01): superseded by CarUserNickname — a car's name is now
  /// private per viewing user, not one shared global value. Left in place, unused,
  /// so the old data isn't destroyed; backfilled once into CarUserNickname for each
  /// car's original creator (Car.user_id) and never read or written again. Do not
  /// add new reads/writes of this column — resolve a nickname via CarUserNickname.
  nickname                  String?                 @unique
  make                      String
  model                     String
  variant                   String?
  year                      Int?
  license_plate             String?
  fuel_type                 FuelType?
  transmission              TransmissionType?
  engine                    String?
  color                     String?
  current_mileage           Int?
  actual_mileage            Int?
  actual_mileage_updated_at DateTime?
  purchase_price            Float?
  purchase_price_currency   String?                 @default("EUR")
  ownership_start_date      DateTime?
  rca_expiry_date           DateTime?
  itp_expiry_date           DateTime?
  rov_expiry_date           DateTime?
  last_oil_service_date     DateTime?
  last_oil_service_mileage  Int?
  status                    CarStatus               @default(ACTIVE)
  sold_at                   DateTime?
  // Spending ceiling the wishlist's "budget line" is drawn at. One per car
  // (shared with co-owners), not per user — see CarWish.
  wishlist_budget           Float?
  created_at                DateTime                @default(now())
  user_id                   Int
  user                      User                    @relation(fields: [user_id], references: [id])
  // Null = personal B2C car (the default, unchanged behavior). Set only for
  // a car that belongs to a company tenant — see Organization.
  organization_id           Int?
  organization              Organization?           @relation(fields: [organization_id], references: [id])
  maintenanceRecords        MaintenanceRecord[]
  documents                 Document[]
  photos                    CarPhoto[]
  access_entries            CarUserAccess[]
  blog_entries              BlogEntry[]
  deadline_orders           CarDeadlineOrder[]
  reminders_sent            DocumentReminderSent[]
  notes                     CarNote[]
  maintenance_settings      CarMaintenanceSetting[]
  maintenance_profiles      MaintenanceProfile[]
  sale_contracts            SaleContract[]
  wishes                    CarWish[]
  driver_assignments        CarDriverAssignment[]
  user_nicknames            CarUserNickname[]
}

/// A private, per-viewer name for a car — "what I personally call this car",
/// visible only to the user who set it. Replaces the old global `Car.nickname`
/// column: an org Director, a co-owner with shared access, and the car's own
/// creator can each set a completely different label for the same car, and
/// none of them ever see each other's. No row = that user hasn't set one yet,
/// and display code falls back to make+model. Deleting the row (rather than
/// storing an empty string) is how "clear my label" is represented.
model CarUserNickname {
  id         Int      @id @default(autoincrement())
  car_id     Int
  user_id    Int
  nickname   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  car  Car  @relation(fields: [car_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([car_id, user_id])
  @@index([user_id])
}

model CarNote {
  id           Int      @id @default(autoincrement())
  car_id       Int
  title        String
  content      String
  // Legacy single group — superseded by `labels`. Read lazily as labels=[group_name]
  // when labels is empty; cleared whenever an update sends labels.
  group_name   String?
  labels       String[] @default([])
  is_checklist Boolean  @default(false)
  // Checklist display: false = ticked items drop into a "checked" section at the
  // bottom (Keep's default); true = they stay where they are, just struck through.
  checked_in_place Boolean @default(false)
  // [{ "text": string, "checked": boolean }] — only meaningful when is_checklist
  items        Json?
  // Palette key (coral, peach, sand, mint, sage, fog, storm, dusk, blossom, clay); null = default
  color        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  car          Car      @relation(fields: [car_id], references: [id], onDelete: Cascade)
}

// A thing the owner wants done to the car but hasn't paid for yet. Ordered by
// hand (`position`, lowest first) rather than by date — the wishlist's whole
// point is the priority order, which is what the budget line is read against.
// Completing a wish doesn't archive it in place: it graduates into a real
// MaintenanceRecord via the pre-filled maintenance form, and the wish is only
// kept as DONE for history.
model CarWish {
  id             Int           @id @default(autoincrement())
  car_id         Int
  title          String
  notes          String?
  estimated_cost Float?
  // Same axis as MaintenanceRecord.service_type, so a completed wish can
  // pre-fill the maintenance form without a mapping table.
  service_type   ServiceType?
  position       Int           @default(0)
  status         CarWishStatus @default(ACTIVE)
  done_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  car            Car           @relation(fields: [car_id], references: [id], onDelete: Cascade)

  @@index([car_id, status, position])
}

enum CarWishStatus {
  ACTIVE
  DONE
  DROPPED
}

model CarUserAccess {
  id                 Int           @id @default(autoincrement())
  car_id             Int
  user_id            Int
  role               CarAccessRole
  invited_by_user_id Int
  accepted_at        DateTime?
  created_at         DateTime      @default(now())

  car        Car  @relation(fields: [car_id], references: [id], onDelete: Cascade)
  user       User @relation("UserAccesses", fields: [user_id], references: [id])
  invited_by User @relation("InvitedBy", fields: [invited_by_user_id], references: [id])

  @@unique([car_id, user_id])
  @@index([user_id])
  @@index([car_id])
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  type       NotificationType
  data       Json
  read_at    DateTime?
  created_at DateTime         @default(now())
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, read_at])
}

enum NotificationType {
  CAR_SHARED
  CAR_ACCESS_REMOVED
  CAR_ACCESS_ROLE_CHANGED
  CAR_ACCESS_ACCEPTED
  DOCUMENT_EXPIRING
  VIN_CONFLICT
  LICENSE_PLATE_CONFLICT
  ORG_INVITED
  ORG_INVITE_ACCEPTED
  // Account-level (not org-bound) — visible in any session context, see NotificationsService.filterForContext.
  BUSINESS_ACCESS_REQUESTED
  BUSINESS_ACCESS_APPROVED
  BUSINESS_ACCESS_REJECTED
}

enum DocumentExpiryType {
  RCA
  ITP
  ROVINIETA
}

model DocumentReminderSent {
  id          Int                @id @default(autoincrement())
  user_id     Int
  car_id      Int
  doc_type    DocumentExpiryType
  expiry_date DateTime
  days_before Int
  sent_at     DateTime           @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [car_id], references: [id], onDelete: Cascade)

  @@unique([user_id, car_id, doc_type, expiry_date, days_before])
}

model PushToken {
  id         Int          @id @default(autoincrement())
  user_id    Int
  token      String       @unique
  platform   PushPlatform
  created_at DateTime     @default(now())
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

enum PushPlatform {
  ANDROID
  WEB
}

model CarPhoto {
  id         Int     @id @default(autoincrement())
  car_id     Int
  url        String
  is_default Boolean @default(false)
  car        Car     @relation(fields: [car_id], references: [id], onDelete: Cascade)
}

model Document {
  id                Int       @id @default(autoincrement())
  car_id            Int
  document_type     String
  issue_date        DateTime?
  expiry_date       DateTime?
  provider          String?
  policy_series     String?
  policy_number     String?
  premium           Float?
  currency          String?
  bonus_malus_class String?
  status            String?   @default("Active")
  policyholder      String?
  cnp_id            String?
  file_url          String?
  file_name         String?
  file_size         Int?
  is_active         Boolean   @default(true)
  /// ISO 3166-1 alpha-2 country a vignette (ROV) is valid in. Null means the
  /// home country (RO) — every vignette created before this column existed.
  country           String?
  /// `premium` converted to RON (= premium for RON prices). Null when there is
  /// no premium, or when no exchange rate could be obtained for `currency`.
  premium_ron          Float?
  /// RON per 1 unit of `currency` used for `premium_ron` (BNR multiplier already applied).
  exchange_rate        Float?
  /// BNR publication date of the rate used (not the save time); today for MANUAL, null for RON.
  exchange_rate_date   DateTime?
  /// 'BNR' when fetched automatically, 'MANUAL' when supplied by the client; null for RON.
  exchange_rate_source String?
  created_at        DateTime  @default(now())
  car               Car       @relation(fields: [car_id], references: [id], onDelete: Cascade)
  // Optional link into the supplier directory (e.g. the broker an RCA/CASCO
  // policy was issued through). `provider` above stays free text — this is
  // the structured link, independent of it.
  supplier_id       Int?
  supplier          Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
}

model MaintenanceRecord {
  id                 Int               @id @default(autoincrement())
  car_id             Int
  service_date       DateTime
  mileage            Int?
  description        String
  service_type       ServiceType
  service_category   ServiceCategory   @default(OTHER)
  cost               Float
  // Currency the cost was paid in, and its RON equivalent — same shape as
  // Document's premium/currency/premium_ron conversion (see document.service.ts).
  currency           String            @default("RON")
  cost_ron           Float?
  exchange_rate      Float?
  exchange_rate_date DateTime?
  exchange_rate_source String?
  expiry_date        DateTime?
  is_diy             Boolean           @default(false)
  fuel_liters        Float?
  energy_kwh         Float?
  is_company_expense Boolean           @default(false)
  created_at         DateTime          @default(now())
  car                Car               @relation(fields: [car_id], references: [id], onDelete: Cascade)
  parts              MaintenancePart[]
  // Which supplier (garage/workshop) carried out this work — optional, null
  // for DIY or when the supplier directory isn't used.
  supplier_id        Int?
  supplier           Supplier?         @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
}

model MaintenancePart {
  id                    Int               @id @default(autoincrement())
  maintenance_record_id Int
  name                  String
  code                  String?
  quantity              Float?
  price                 Float?
  maintenanceRecord     MaintenanceRecord @relation(fields: [maintenance_record_id], references: [id], onDelete: Cascade)
}

enum SupplierType {
  SERVICE   // garaj / service auto
  PARTS     // furnizor piese
  INSURANCE // broker / asigurator
  FUEL      // furnizor carburant
  OTHER
}

// Directory of external parties a car is serviced/insured/supplied through.
// Personal (user_id only) or shared across an organization's fleet
// (organization_id set) — same ownership split as Car.
model Supplier {
  id               Int                 @id @default(autoincrement())
  name             String
  type             SupplierType        @default(OTHER)
  contact_name     String?
  phone            String?
  email            String?
  address          String?
  notes            String?
  is_active        Boolean             @default(true)
  created_at       DateTime            @default(now())
  user_id          Int
  user             User                @relation(fields: [user_id], references: [id])
  // Null = personal supplier, visible only to its creator (same convention as Car.organization_id).
  organization_id  Int?
  organization     Organization?       @relation(fields: [organization_id], references: [id])
  documents        Document[]
  maintenance_records MaintenanceRecord[]
}

/// Who drove an organization-owned car, and when. One row per assignment
/// period: `ended_at: null` means it's the car's current driver; assigning a
/// new driver closes the previous row instead of overwriting it, so the full
/// history survives. Only meaningful for `Car.organization_id != null` — a
/// personal B2C car has no concept of a driver distinct from its owner.
model CarDriverAssignment {
  id                  Int       @id @default(autoincrement())
  car_id              Int
  driver_user_id      Int
  assigned_by_user_id Int
  started_at          DateTime  @default(now())
  ended_at            DateTime?
  notes               String?

  car         Car  @relation(fields: [car_id], references: [id], onDelete: Cascade)
  driver      User @relation("DriverAssignments", fields: [driver_user_id], references: [id])
  assigned_by User @relation("DriverAssignmentsMadeBy", fields: [assigned_by_user_id], references: [id])

  @@index([car_id, ended_at])
  @@index([driver_user_id])
}

enum CarStatus {
  ACTIVE
  SOLD
}

enum CarAccessRole {
  OWNER
  FULL
  USER
  MAINTENANCE
  VIEWER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum ServiceType {
  REPAIR
  MAINTENANCE
  IMPROVEMENT
  PASSION
  ALIMENTARE
}

enum ServiceCategory {
  OIL_CHANGE
  BRAKE_SERVICE
  TRANSMISSION_SERVICE
  TIRE_SERVICE
  FLUID_SERVICE
  ENGINE_SERVICE
  INSPECTION
  BATTERY_SERVICE
  FILTER_SERVICE
  LIGHT_SERVICE
  COMBUSTIBIL
  OTHER
}

model CarMake {
  id              Int               @id @default(autoincrement())
  name            String
  normalized_name String            @unique
  source          String            @default("manual")
  external_id     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  models          CarCatalogModel[]

  @@index([normalized_name])
  @@map("car_makes")
}

model CarCatalogModel {
  id              Int            @id @default(autoincrement())
  make_id         Int
  name            String
  normalized_name String
  source          String         @default("manual")
  external_id     String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  make            CarMake        @relation(fields: [make_id], references: [id])
  years           CarModelYear[]

  @@unique([make_id, normalized_name])
  @@index([make_id, normalized_name])
  @@map("car_models")
}

model CarModelYear {
  id         Int             @id @default(autoincrement())
  model_id   Int
  year       Int
  source     String          @default("manual")
  created_at DateTime        @default(now())
  model      CarCatalogModel @relation(fields: [model_id], references: [id])

  @@unique([model_id, year])
  @@index([model_id])
  @@map("car_model_years")
}

enum BlogCategory {
  PERSONAL
  VEHICLE
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum VehicleEntryCategory {
  REPAIR
  SERVICE_VISIT
  TRIP
  FUEL
  UPGRADE
  INSPECTION
  BREAKDOWN
  OTHER
}

model BlogEntry {
  id               Int                   @id @default(autoincrement())
  user_id          Int
  category         BlogCategory
  title            String
  slug             String?               @unique
  excerpt          String?
  date             DateTime
  content          String                @default("")
  content_json     Json?
  status           BlogStatus            @default(DRAFT)
  published_at     DateTime?
  is_pinned        Boolean               @default(false)
  cover_gradient   String?
  cover_image_url  String?
  car_id           Int?
  vehicle_category VehicleEntryCategory?
  km               Int?
  price            Float?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  user             User                  @relation(fields: [user_id], references: [id])
  car              Car?                  @relation(fields: [car_id], references: [id], onDelete: SetNull)
  tags             BlogTag[]
  images           BlogImage[]

  @@index([user_id])
  @@index([car_id])
  @@index([slug])
  @@index([status])
}

model BlogTag {
  id            Int       @id @default(autoincrement())
  blog_entry_id Int
  label         String
  color         String
  blog_entry    BlogEntry @relation(fields: [blog_entry_id], references: [id], onDelete: Cascade)
}

model BlogImage {
  id            Int       @id @default(autoincrement())
  blog_entry_id Int
  url           String
  blog_entry    BlogEntry @relation(fields: [blog_entry_id], references: [id], onDelete: Cascade)
}

enum UploadStatus {
  PENDING
  UPLOADED
  DELETED
}

model UserSettings {
  id                       Int      @id @default(autoincrement())
  user_id                  Int      @unique
  user                     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  language                 String   @default("en")
  theme                    String   @default("auto")
  view_mode                String   @default("cards")
  expiry_reminders_enabled Boolean  @default(true)
  expiry_reminder_days     Int[]    @default([7])
  navigation_prefs         Json?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

model UploadedFile {
  id                 Int          @id @default(autoincrement())
  user_id            Int
  context_type       String
  context_id         Int?
  original_file_name String
  file_key           String       @unique
  mime_type          String
  size               Int
  status             UploadStatus @default(PENDING)
  created_at         DateTime     @default(now())
  uploaded_at        DateTime?
  deleted_at         DateTime?
  user               User         @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([context_type, context_id])
  @@map("uploaded_files")
}

/// The order in which one user wants a car's deadlines (documents + maintenance)
/// listed on the car hub. Per user as well as per car: a shared car can be
/// arranged differently by each person who sees it.
model CarDeadlineOrder {
  id             Int      @id @default(autoincrement())
  car_id         Int
  user_id        Int
  /// Ordered list of stable deadline keys, e.g. ["doc:RCA", "plan:OIL_CHANGE"].
  /// Empty array = back to the automatic, most-urgent-first order.
  item_keys      String[]
  /// Deadline keys the user dismissed from the list entirely (document-kind
  /// only — maintenance categories use CarMaintenanceSetting.tracked instead,
  /// which already has its own undo UI). Empty array = nothing dismissed.
  dismissed_keys String[] @default([])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  car  Car  @relation(fields: [car_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([car_id, user_id])
}

/// A named, per-user set of maintenance overrides for one car — an alternative to the
/// three built-in usage profiles (normal/intensive/occasional, which stay client-side
/// and are never persisted here). Created either implicitly (default name "Profilul
/// meu") the moment a user edits an interval while a built-in profile is selected, or
/// explicitly when they want more than one (e.g. "Iarnă", "Taxi"). Deleting a profile
/// cascades its CarMaintenanceSetting rows.
model MaintenanceProfile {
  id         Int      @id @default(autoincrement())
  car_id     Int
  user_id    Int
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  car      Car                     @relation(fields: [car_id], references: [id], onDelete: Cascade)
  user     User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  settings CarMaintenanceSetting[]

  @@unique([car_id, user_id, name])
}

/// A per-user override of a maintenance category on one car, scoped to a specific
/// MaintenanceProfile: whether the user wants it tracked (progress bar shown) and/or
/// a custom interval instead of the global default from DEFAULT_MAINTENANCE_INTERVALS.
/// Sparse on purpose — a row only exists when the user deviates from the neutral state
/// (tracked=true, no custom interval) within that profile; resetting back to neutral
/// deletes the row rather than storing a no-op override.
model CarMaintenanceSetting {
  id                     Int             @id @default(autoincrement())
  car_id                 Int
  user_id                Int
  profile_id             Int
  category               ServiceCategory
  tracked                Boolean         @default(true)
  custom_interval_km     Int?
  custom_interval_months Int?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  car     Car                @relation(fields: [car_id], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  profile MaintenanceProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([car_id, user_id, profile_id, category])
}

// A destination shared from a phone (Google Maps) to be picked up by the car head unit
// (BMWSimulation / ro.denhau.bmwcockpit). Intentionally not tied to a User: the channel is
// identified only by an unguessable [slug], so the car can read it with a plain GET and no login.
// Each share is a new row; the car keeps the last [id] it acted on and polls for a greater one.
model NavDestination {
  id         Int      @id @default(autoincrement())
  slug       String
  name       String?
  lat        Float?
  lon        Float?
  raw_url    String
  created_at DateTime @default(now())

  @@index([slug, id])
  @@map("nav_destinations")
}

/// The head unit's own settings and saved places, one document per channel. The server stores it
/// verbatim and never reads inside it, so adding a setting on the car needs no migration here.
/// [revision] is lifted out of the payload only so a stale device can be refused without parsing it.
model CockpitProfile {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  revision   Int      @default(0)
  payload    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("cockpit_profiles")
}

// ---------------------------------------------------------------------------
// Sale contract (ITL 054, Anexa nr. 2 — "contract de înstrăinare-dobândire")
//
// Every field that identifies a natural person lives inside an encrypted blob
// (`data_encrypted`, AES-256-GCM) rather than in its own column. Two reasons:
// the other party to a sale is a third party who never agreed to have their
// CNP sitting in our database in the clear, and honouring a deletion request
// then means nulling one column instead of auditing thirty.
// ---------------------------------------------------------------------------

/// Which side of the sale the app's own user is on. Drives which party gets
/// pre-filled from the user's saved identity, and what happens to the car
/// afterwards (a sale marks it SOLD; a purchase can add it to the garage).
enum SaleContractRole {
  SELLER
  BUYER
}

enum SaleContractPartySide {
  SELLER
  BUYER
}

enum SaleContractStatus {
  DRAFT
  GENERATED
  /// Personal data purged by the retention job; the row is kept only so the
  /// car's history still shows that a sale happened, and on what date.
  PURGED
}

model SaleContract {
  id      Int              @id @default(autoincrement())
  user_id Int
  /// Null when the contract is for a vehicle that isn't (yet) in the garage —
  /// the common case when the user is the buyer.
  car_id  Int?
  role    SaleContractRole

  // --- Vehicle, section (3) — a snapshot, deliberately denormalised.
  // A contract is a historical record: editing the car afterwards must not
  // rewrite what the parties actually signed.
  vehicle_make        String?
  vehicle_type        String?
  vin                 String?
  engine_series       String?
  engine_capacity_cm3 Int?
  max_weight_tons     Decimal?  @db.Decimal(10, 3)
  license_plate       String?
  itp_expiry_date     DateTime?
  civ_number          String?
  manufacture_year    Int?
  euro_norm           String?
  acquired_date       DateTime?
  acquired_document   String?

  // --- Price, section (4)
  price_lei      Decimal? @db.Decimal(14, 2)
  price_in_words String?

  // --- Signing, and the in-app confirmations that stand behind it
  signing_date        DateTime?
  signing_place       String?
  /// "Anexe la contract: Da / Nu" — a tick box on the form itself.
  has_annexes         Boolean   @default(false)
  /// What the user ticked before we generated the PDF, and when. This is our
  /// evidence that the declarations at section (5) were shown and accepted —
  /// it protects us as the tool's provider, it is not part of the form.
  confirmations       Json?
  /// Consent for processing the *other* party's identity document.
  consent_accepted_at DateTime?
  consent_version     String?

  status           SaleContractStatus @default(DRAFT)
  pdf_key          String?
  pdf_generated_at DateTime?

  /// After this moment the retention job purges the parties' personal data and
  /// deletes the stored PDF. Extended when the user explicitly opts to keep the
  /// contract in the car's history.
  retention_until         DateTime
  personal_data_purged_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    User                @relation(fields: [user_id], references: [id])
  car     Car?                @relation(fields: [car_id], references: [id], onDelete: SetNull)
  parties SaleContractParty[]

  @@index([user_id])
  @@index([car_id])
  @@index([retention_until])
  @@map("sale_contracts")
}

model SaleContractParty {
  id          Int                   @id @default(autoincrement())
  contract_id Int
  side        SaleContractPartySide
  is_company  Boolean               @default(false)

  /// AES-256-GCM blob holding the whole party payload (name, address, fiscal
  /// domicile, ID series/number, CNP/CIF, phone, e-mail, representative).
  /// Null once purged. Nothing identifying is stored outside it — not even a
  /// masked name — so a leak of the table alone yields no personal data.
  data_encrypted String?

  contract SaleContract @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  @@unique([contract_id, side])
  @@map("sale_contract_parties")
}

/// The user's own identity details, saved once so they don't rescan their ID
/// for every contract. Same encrypted-blob treatment as a contract party.
model UserIdentity {
  id             Int      @id @default(autoincrement())
  user_id        Int      @unique
  data_encrypted String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_identities")
}

// ---------------------------------------------------------------------------
// B2B multi-tenant foundation (Organization). Additive only — every car's
// `organization_id` stays null for personal accounts, so none of this
// changes behavior for existing B2C users. See /var/www/hau_app/B2B-STRATEGY.md.
// ---------------------------------------------------------------------------

enum OrganizationRole {
  /// True account owner — exactly one per organization, in practice. Never
  /// created, edited or removed through the app itself; assigned directly in
  /// the database when the business account is sold. Outranks everyone,
  /// including SUPER_ADMIN/Director — used at its own risk, by design.
  OWNER
  /// "Director" in the UI. Can only be created by OWNER, never by another
  /// Director — Directors can see each other but can't edit or remove one
  /// another. Otherwise full rights: reports/charts across the whole fleet,
  /// defines and manages all staff below Director (fleet admins, finance,
  /// drivers), toggles feature flags for this org.
  SUPER_ADMIN
  /// Day-to-day fleet operator: cars, maintenance, documents, suppliers,
  /// driver assignment — the role matching the fleet-admin job description.
  /// Can only define/manage DRIVERs (the ones they personally invited); only
  /// sees the Director who invited them, not the rest of the org.
  FLEET_ADMIN
  /// Disabled for now (removed from the active scheme) — kept in the enum so
  /// no migration is needed if/when it's reintroduced. Not offered anywhere
  /// in the invite UI or permission matrix.
  MANAGER
  /// Restricted to their assigned car(s): can log fuel/mileage, flag issues.
  /// Doesn't see the organization screen/chip at all.
  DRIVER
  /// Costs/reports only (invoices, fuel, charts) — scope still to be defined,
  /// not a current focus. Read-only for now, no operational access.
  FINANCE
}

/// A company-level tenant for B2B fleet customers.
model Organization {
  id         Int      @id @default(autoincrement())
  name       String
  /// Stable company code used to log in company-managed accounts
  /// (`<username>@<login_code>` is the stored User.email). Lowercase [a-z0-9-],
  /// 3-40 chars. Never changes on rename. Nullable only for the push; always set by the app.
  login_code String?  @unique
  created_at DateTime @default(now())
  /// e.g. "starter" | "fleet" | "enterprise" — drives billing & feature gating.
  plan          String?
  /// Per-organization feature toggles (e.g. { "sale_contract": false }).
  /// Reserved now, not yet read anywhere — see B2B-STRATEGY.md section 4.
  feature_flags Json?
  /// White-label overrides (logo_url, primary_color, app_name) reserved for a
  /// future dedicated/branded deployment — see B2B-STRATEGY.md section 3.
  /// Not yet read anywhere.
  branding      Json?

  members           OrganizationMembership[]
  cars              Car[]
  feature_interests FeatureInterest[]
  suppliers         Supplier[]
}

model OrganizationMembership {
  id                 Int              @id @default(autoincrement())
  organization_id    Int
  user_id            Int
  role               OrganizationRole
  invited_by_user_id Int
  accepted_at        DateTime?
  created_at         DateTime         @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationMemberships", fields: [user_id], references: [id])
  invited_by   User         @relation("OrganizationInvitedBy", fields: [invited_by_user_id], references: [id])

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@index([organization_id])
}

/// A click of interest on a not-yet-built feature, registered from the
/// "coming soon" panel. `feature_key` matches the keys used in
/// Organization.feature_flags, so recorded interest can become an enabled
/// flag later without re-architecting. One row per (org, user, feature) —
/// a repeat click is an idempotent no-op, not a new row.
model FeatureInterest {
  id              Int      @id @default(autoincrement())
  organization_id Int
  user_id         Int
  feature_key     String
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, feature_key])
}

enum BusinessAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user's request to be allowed to create an organization (the "business account
/// approval gate" — see OrganizationService.createOrganization). Reviewed by an
/// app admin (`User.is_admin`) on the admin page. A user may submit a new request
/// after a REJECTED one, so several rows can exist per user — only the latest matters.
model BusinessAccessRequest {
  id                  Int                         @id @default(autoincrement())
  user_id             Int
  company_name        String
  note                String?
  status              BusinessAccessRequestStatus @default(PENDING)
  rejection_reason    String?
  decided_by_user_id  Int?
  decided_at          DateTime?
  created_at          DateTime                    @default(now())

  user        User  @relation("BusinessAccessRequests", fields: [user_id], references: [id], onDelete: Cascade)
  decided_by  User? @relation("BusinessAccessDecisions", fields: [decided_by_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([status])
}

// One row per user per (Europe/Bucharest) calendar day on which they made at
// least one authenticated API call. Source for DAU/WAU/MAU, retention cohorts
// and platform/app-version split on the admin page. Written in batches by
// ActivityService (buffered in memory, flushed every minute).
model UserActivityDay {
  user_id       Int
  date          DateTime @db.Date
  platform      String?
  app_version   String?
  request_count Int      @default(0)
  first_seen_at DateTime @default(now())
  last_seen_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, date])
  @@index([date])
  @@map("user_activity_days")
}

enum VehicleSilhouetteStatus {
  READY
  PENDING
  FAILED
}

// Global shared asset (not tied to any user or organization): one AI-generated schematic
// side-profile SVG per make + model, generated once and reused by everyone.
model VehicleSilhouette {
  id               Int                     @id @default(autoincrement())
  make_normalized  String
  model_normalized String
  make_display     String
  model_display    String
  svg              String?                 @db.Text
  status           VehicleSilhouetteStatus @default(PENDING)
  source           String                  @default("gemini")
  error            String?
  attempts         Int                     @default(0)
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt

  @@unique([make_normalized, model_normalized])
  @@map("vehicle_silhouettes")
}
