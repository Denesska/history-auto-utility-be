  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:live": "nest start --watch",
    "start:dev": "NODE_ENV=development npm run start:live",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "start:dev-server": "ENV_FILE=.env.dev NODE_ENV=development nest start --watch --preserveWatchOutput",
    "db:push:dev": "DATABASE_URL=\"postgresql://postgres:123Hello!@localhost:5432/hau_db_dev?schema=public\" prisma db push",
    "db:push:test": "DATABASE_URL=\"postgresql://postgres:123Hello!@localhost:5432/hau_db_test?schema=public\" prisma db push",
    "start:test-server": "ENV_FILE=.env.test NODE_ENV=production node dist/src/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:vehicle-catalog": "ts-node prisma/seed-vehicle-catalog.ts",
    "seed:carsbase": "ts-node prisma/seed-carsbase.ts",
    "seed:teoalida": "ts-node prisma/seed-teoalida.ts",
